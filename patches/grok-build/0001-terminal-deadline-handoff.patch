+    #[tokio::test]
+    async fn test_explicit_runtime_deadline_survives_auto_background_handoff() {
+        // Regression test for Issue #62:
+        // When a foreground command with explicit positive timeout auto-backgrounds at its
+        // foreground_block_budget, it must preserve the original requested timeout as its
+        // total runtime deadline instead of expanding to BACKGROUND_MAX_RUNTIME (10 hours).
+        let backend = LocalTerminalBackend::new_with_foreground_budget(Duration::from_millis(200));
+
+        let output_file = std::env::temp_dir().join(format!(
+            "terminal-test-explicit-deadline-{}.out",
+            std::process::id()
+        ));
+        let tool_call_id = "test-explicit-deadline-survives";
+
+        let explicit_timeout = Duration::from_millis(800);
+        let request = TerminalRunRequest {
+            command: "sleep 60".to_string(),
+            working_directory: std::env::temp_dir(),
+            env: HashMap::new(),
+            timeout: explicit_timeout,
+            output_byte_limit: 10000,
+            output_file: output_file.clone(),
+            notification_handle: ToolNotificationHandle::noop(),
+            tool_call_id: tool_call_id.to_string(),
+            display_command: None,
+            auto_background_on_timeout: true,
+            foreground_block_budget: Some(Duration::from_millis(200)),
+            kind: TaskKind::Bash,
+            owner_session_id: None,
+            description: None,
+        };
+
+        let start = Instant::now();
+        let result = backend.run(request).await.unwrap();
+        let elapsed = start.elapsed();
+
+        assert_eq!(result.signal.as_deref(), Some("auto_backgrounded"));
+        assert!(
+            elapsed < Duration::from_secs(2),
+            "should auto-bg after foreground budget (~200ms), took {elapsed:?}"
+        );
+
+        // Wait for process to hit the explicit timeout (800ms)
+        tokio::time::sleep(Duration::from_millis(900)).await;
+
+        let snapshot = backend
+            .get_task(tool_call_id)
+            .await
+            .expect("task snapshot should exist");
+
+        assert!(
+            snapshot.completed,
+            "task should have completed (timed out) at its explicit deadline rather than running for 10h"
+        );
+        assert_eq!(
+            snapshot.signal.as_deref(),
+            Some("timeout"),
+            "signal should reflect timeout after explicit deadline, got {:?}",
+            snapshot.signal
+        );
+
+        let _ = tokio::fs::remove_file(&output_file).await;
+    }
+
+    #[tokio::test]
+    async fn test_omitted_timeout_auto_yields_without_inheriting_foreground_default_deadline() {
+        // Regression test for Issue #62:
+        // When timeout is omitted or defaulted (explicit_timeout=false), auto-backgrounding
+        // must retain normal background task lifetime (BACKGROUND_MAX_RUNTIME) rather
+        // than prematurely killing the command when the foreground default deadline expires.
+        let backend = LocalTerminalBackend::new_with_foreground_budget(Duration::from_millis(200));
+
+        let output_file = std::env::temp_dir().join(format!(
+            "terminal-test-omitted-timeout-yields-{}.out",
+            std::process::id()
+        ));
+        let tool_call_id = "test-omitted-timeout-yields";
+
+        let request = TerminalRunRequest {
+            command: "sleep 60".to_string(),
+            working_directory: std::env::temp_dir(),
+            env: HashMap::new(),
+            timeout: BACKGROUND_MAX_RUNTIME,
+            output_byte_limit: 10000,
+            output_file: output_file.clone(),
+            notification_handle: ToolNotificationHandle::noop(),
+            tool_call_id: tool_call_id.to_string(),
+            display_command: None,
+            auto_background_on_timeout: true,
+            foreground_block_budget: Some(Duration::from_millis(200)),
+            kind: TaskKind::Bash,
+            owner_session_id: None,
+            description: None,
+        };
+
+        let start = Instant::now();
+        let result = backend.run(request).await.unwrap();
+        let elapsed = start.elapsed();
+
+        assert_eq!(result.signal.as_deref(), Some("auto_backgrounded"));
+        assert!(
+            elapsed < Duration::from_secs(2),
+            "should auto-bg after foreground budget (~200ms), took {elapsed:?}"
+        );
+
+        // Wait past the original 600ms foreground timeout
+        tokio::time::sleep(Duration::from_millis(800)).await;
+
+        let snapshot = backend
+            .get_task(tool_call_id)
+            .await
+            .expect("task snapshot should exist");
+
+        // Because explicit_timeout=false, the task must NOT have timed out at 600ms
+        assert!(
+            !snapshot.completed,
+            "omitted/default timeout task must continue running in background under BACKGROUND_MAX_RUNTIME"
+        );
+
+        let _ = backend.kill_task(tool_call_id).await;
+        let _ = tokio::fs::remove_file(&output_file).await;
+    }
+
+    #[tokio::test]
+    async fn test_omitted_timeout_with_zero_budget_auto_yields_at_foreground_default() {
+        // Regression test for Issue #62:
+        // When foreground_block_budget_ms = 0 (short budget disabled) and timeout is omitted,
+        // the handoff budget becomes the effective foreground default timeout (simulated here
+        // at 250ms). The command must NOT auto-bg before 250ms, MUST auto-yield at 250ms,
+        // and must then remain alive in the background under BACKGROUND_MAX_RUNTIME rather
+        // than timing out.
+        let backend = LocalTerminalBackend::new();
+
+        let output_file = std::env::temp_dir().join(format!(
+            "terminal-test-zero-budget-omitted-timeout-{}.out",
+            std::process::id()
+        ));
+        let tool_call_id = "test-zero-budget-omitted-timeout";
+
+        let fg_default_timeout = Duration::from_millis(250);
+        let request = TerminalRunRequest {
+            command: "sleep 60".to_string(),
+            working_directory: std::env::temp_dir(),
+            env: HashMap::new(),
+            timeout: BACKGROUND_MAX_RUNTIME,
+            output_byte_limit: 10000,
+            output_file: output_file.clone(),
+            notification_handle: ToolNotificationHandle::noop(),
+            tool_call_id: tool_call_id.to_string(),
+            display_command: None,
+            auto_background_on_timeout: true,
+            foreground_block_budget: Some(fg_default_timeout),
+            kind: TaskKind::Bash,
+            owner_session_id: None,
+            description: None,
+        };
+
+        let start = Instant::now();
+        let result = backend.run(request).await.unwrap();
+        let elapsed = start.elapsed();
+
+        assert_eq!(result.signal.as_deref(), Some("auto_backgrounded"));
+        assert!(
+            elapsed >= Duration::from_millis(200),
+            "must not auto-bg before foreground default timeout (~250ms), took {elapsed:?}"
+        );
+
+        // Wait past 250ms and verify process is still running under BACKGROUND_MAX_RUNTIME
+        tokio::time::sleep(Duration::from_millis(300)).await;
+
+        let snapshot = backend
+            .get_task(tool_call_id)
+            .await
+            .expect("task snapshot should exist");
+
+        assert!(
+            !snapshot.completed,
+            "task must remain alive in background under BACKGROUND_MAX_RUNTIME, not killed at default timeout"
+        );
+
+        let _ = backend.kill_task(tool_call_id).await;
+        let _ = tokio::fs::remove_file(&output_file).await;
+    }
